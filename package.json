{
  "name": "civicai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "test": "npm --workspace apps/api test",
    "lint": "npm --workspace apps/web run lint",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "health-check": "node scripts/health-check.js",
    "check:media": "node scripts/check-media.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
